#!/usr/bin/env sh

branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ]; then
  echo "✖ Direct commits to 'main' are not allowed. Create a feature branch:"
  echo "    git switch -c feat/your-change"
  echo "  Bypass intentionally with: git commit --no-verify"
  exit 1
fi

pnpm lint-staged
