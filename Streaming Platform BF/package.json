{
  "name": "bfbs-mobile",
  "main": "expo-router/entry",
  "version": "4.2.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:release": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android --variant release --no-bundler",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:mobile-dev:android": "pnpm dlx eas-cli@19.1.0 build --platform android --profile mobile-dev --local --non-interactive",
    "build:mobile-dev:ios": "pnpm dlx eas-cli@19.1.0 build --platform ios --profile mobile-dev --local --non-interactive",
    "build:mobile-dev:ios-simulator": "pnpm dlx eas-cli@19.1.0 build --platform ios --profile mobile-dev-simulator --local --non-interactive",
    "build:release-test:ios": "pnpm dlx eas-cli@19.1.0 build --platform ios --profile release-test-ios --local --non-interactive",
    "build:release-test:google-play": "pnpm dlx eas-cli@19.1.0 build --platform android --profile release-test-google-play --local --non-interactive",
    "build:release-test:amazon-appstore": "pnpm dlx eas-cli@19.1.0 build --platform android --profile release-test-amazon-appstore --local --non-interactive",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "react-compiler:report": "node ./scripts/react-compiler-report.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "storybook-generate": "sb-rn-get-stories",
    "storybook": "EXPO_PUBLIC_ENVIRONMENT='storybook' expo start",
    "docs:start": "pnpm --filter @bfbs/docs-website start",
    "docs:build": "pnpm --filter @bfbs/docs-website build"
  },
  "dependencies": {
    "@babel/core": "~7.29.7",
    "@bfbs/common-sdk": "0.1.1794838916-branch-main",
    "@featurevisor/sdk": "2.20.0",
    "@featurevisor/types": "2.20.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/datetimepicker": "~9.1.0",
    "@react-native-community/slider": "~5.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "~8.12.0",
    "@tanstack/react-query": "5.100.14",
    "babel-loader": "~8.4.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "bitmovin-player-react-native": "1.19.0",
    "expo": "~55.0.23",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-device": "~55.0.16",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.10",
    "expo-linear-gradient": "~55.0.15",
    "expo-linking": "~55.0.15",
    "expo-modules-core": "55.0.25",
    "expo-navigation-bar": "~55.0.13",
    "expo-network": "~55.0.18",
    "expo-router": "~55.0.14",
    "expo-screen-orientation": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.17",
    "expo-web-browser": "~55.0.15",
    "jail-monkey": "^3.0.0",
    "nativewind": "~4.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "~15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@storybook/addon-ondevice-actions": "10.4.4",
    "@storybook/addon-ondevice-controls": "10.4.4",
    "@storybook/react-native": "10.4.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.22",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.17",
    "lint-staged": "^16.4.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-compiler-marker": "0.2.0",
    "react-native-svg-transformer": "~1.5.3",
    "storybook": "10.4.1",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svg.tsx",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.ts",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@bfbs/common-sdk/device-integrity/native$": "<rootDir>/__mocks__/common-sdk-device-integrity.ts",
      "^@bfbs/common-sdk/playback/bitmovin/native$": "<rootDir>/__mocks__/common-sdk-bitmovin.ts",
      "^@sentry/react-native$": "<rootDir>/__mocks__/sentry-react-native.ts",
      "^bitmovin-player-react-native$": "<rootDir>/__mocks__/bitmovin-player-react-native.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|bitmovin-player-react-native))",
      "node_modules/.pnpm/(?!(bitmovin-player-react-native)@)"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "^20.19.4 || ^22.13.0",
    "pnpm": "11.1.3"
  }
}
