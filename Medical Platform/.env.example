DATABASE_URL_MIGRATE=postgresql://vulna_migrate:vulna@localhost:5432/vulna
DATABASE_URL_API=postgresql://vulna_api:vulna@localhost:5432/vulna
DATABASE_URL_WORKER=postgresql://vulna_worker:vulna@localhost:5432/vulna

NODE_ENV=development
PORT_API=3000
PORT_API_SURVEILLANCE=3001
PORT_WORKER_SURVEILLANCE=3002
SURVEILLANCE_TOKEN=
TRUST_PROXY=1

BINARY_STORE_PATH=./.data/binary
ADMIN_STATIC_PATH=../vulna-admin/dist

OIDC_ISSUER=http://localhost:9000/application/o/vulna/
OIDC_CLIENT_ID=ansora-vulna-server
OIDC_CLIENT_SECRET=vulna-dev-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/login/oidc/return
OIDC_ADMINISTRATION_REDIRECT_URI=http://localhost:5173/api/admin/v1/login/oidc/callback
OIDC_SCOPES="openid profile email offline_access personal_number groups"

DEVICE_REGISTRATION_SECRET=

HPKE_KEYS_PATH=./.data/hpke
HPKE_CURRENT_KEY_VERSION=

QR_SIGNING_KEYS_PATH=./.data/qr
