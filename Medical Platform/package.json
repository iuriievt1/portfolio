{
	"name": "ansora-vulna",
	"version": "0.0.0",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@11.12.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"build": "nx run-many -t build",
		"build:clean": "tsc --build tsconfig.json --clean",
		"typecheck": "nx run-many -t typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"test": "nx run-many -t test --skip-nx-cache",
		"test:watch": "vitest",
		"test:clinical-record": "pnpm --filter @ansora/vulna-adapter-clinical-record-medplum test:live",
		"test:worker-sql": "pnpm --filter @ansora/server-worker test:db",
		"test:api-sql": "pnpm --filter @ansora/server-api test:db",
		"test:ocr": "pnpm --filter @ansora/server-worker test:ocr",
		"test:system": "bash dev/system/run.sh",
		"graph": "nx graph",
		"contract:bundle": "nx run @ansora/contracts:bundle",
		"contract:generate": "nx run @ansora/contracts:generate",
		"gate:audit": "nx run @ansora/tools:gate:audit --skip-nx-cache",
		"gate:boundaries": "nx run @ansora/tools:gate:boundaries --skip-nx-cache",
		"gate:contract": "nx run @ansora/contracts:gate --skip-nx-cache",
		"gate:image": "nx run @ansora/tools:gate:image --skip-nx-cache",
		"gate:sbom": "nx run @ansora/tools:gate:sbom --skip-nx-cache",
		"gate:trace": "nx run @ansora/tools:gate:trace --skip-nx-cache",
		"gate:trace:release": "nx run @ansora/tools:gate:trace:release --skip-nx-cache",
		"trace:write": "nx run @ansora/tools:trace:write --skip-nx-cache",
		"profile:build": "nx run @ansora/tools:profile:build --skip-nx-cache",
		"pinning:fingerprint": "pnpm --filter @ansora/tools pinning:fingerprint",
		"hpke:keygen": "pnpm --filter @ansora/tools hpke:keygen",
		"qr:keygen": "pnpm --filter @ansora/tools qr:keygen",
		"scan:mobile": "nx run @ansora/tools:scan:mobile --skip-nx-cache",
		"release:record": "nx run @ansora/tools:release:record --skip-nx-cache",
		"gates": "pnpm gate:boundaries && pnpm gate:contract",
		"migrate": "nx run @ansora/server-migrate:start",
		"dev:api": "nx run @ansora/server-api:dev",
		"dev:worker": "nx run @ansora/server-worker:dev",
		"dev:admin": "nx run @ansora/admin:dev",
		"dev:mobile": "nx run @ansora/mobile:start",
		"db:up": "docker compose up -d",
		"db:bootstrap": "bash db/dev/bootstrap.sh",
		"db:seed-registry": "pnpm --filter @ansora/tools registry:seed && docker compose exec -T postgres psql -U postgres -d vulna -v ON_ERROR_STOP=1 -f - < db/dev/patient-identification-configuration.sql",
		"db:seed-demo": "pnpm --filter @ansora/server-api seed:demo",
		"db:reset": "docker compose down -v",
		"env:pacs": "docker compose --profile pacs up -d",
		"env:oidc": "docker compose --profile oidc up -d",
		"env:syslog": "bash dev/syslog/certs.sh && docker compose --profile syslog up -d",
		"env:mock": "docker compose --profile mock up -d",
		"env:tls": "bash dev/tls/certs.sh && docker compose --profile tls up -d tls",
		"env:clinical-record": "bash dev/clinical-record.sh",
		"env:down": "docker compose --profile pacs --profile oidc --profile syslog --profile mock --profile tls --profile clinical-record down pacs oidc oidc-worker oidc-postgres oidc-redis syslog mock-mobile-api mock-admin-api tls clinical-record clinical-record-cache",
		"dicom:peers": "bash dev/dicom/peers.sh",
		"dicom:peers:down": "bash dev/dicom/peers.sh --down",
		"dicom:suite": "bash dev/dicom/suite.sh",
		"image:build": "pnpm profile:build && docker build --build-arg BASE_IMAGE=\"$(cat dist/profile/base-image)\" --build-arg SERVER_VERSION=\"$(git describe --tags --always --dirty)\" -t ansora-vulna-server:dev . && docker build -f deploy/images/valkey/Dockerfile -t ansora-vulna-valkey:dev .",
		"db:down": "docker compose down"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.16.2",
		"@types/node": "^24.10.1",
		"nx": "23.2.1",
		"tsx": "^4.20.7",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
