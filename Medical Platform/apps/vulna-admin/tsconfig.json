{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"es2023",
			"dom",
			"dom.iterable"
		],
		"jsx": "react-jsx",
		"types": [
			"vite/client"
		],
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": [
				"./src/*"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"vite.config.ts"
	]
}
