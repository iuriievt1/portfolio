{
	"name": "@ansora/server-api",
	"version": "0.0.0",
	"private": true,
	"description": "API process: REST for the mobile app, hosting the web administration, sign-in, accepting acquisitions into the outbox, reading history ✓ ADR-005 ř. 37.",
	"license": "UNLICENSED",
	"main": "./dist/main.js",
	"scripts": {
		"dev": "node --watch --require @swc-node/register --env-file-if-exists=../../.env --env-file-if-exists=../../.data/clinical-record.env --env-file-if-exists=../../.data/clinical-record-storage.env src/main.ts",
		"seed:demo": "node --require @swc-node/register --env-file-if-exists=../../.env --env-file-if-exists=../../.data/clinical-record.env scripts/demo-seed/seed.ts",
		"start": "node dist/main.js",
		"build": "tsc --build",
		"typecheck": "tsc -p scripts/demo-seed/tsconfig.json",
		"test": "vitest run",
		"test:db": "vitest run --config vitest.db.config.ts"
	},
	"dependencies": {
		"@ansora/contracts": "workspace:*",
		"@ansora/core-server": "workspace:*",
		"@ansora/vulna-adapter-binary-local": "workspace:*",
		"@ansora/vulna-adapter-clinical-record-medplum": "workspace:*",
		"@ansora/vulna-adapter-oidc": "workspace:*",
		"@ansora/vulna-domain": "workspace:*",
		"@nestjs/common": "^11.1.6",
		"@nestjs/core": "^11.1.6",
		"@nestjs/platform-express": "^11.1.6",
		"@veevoy/postgres": "workspace:*",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/express": "^5.0.5"
	},
	"nx": {
		"tags": [
			"layer:app",
			"process:api"
		]
	}
}
