{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"rootDir": "../..",
		"noEmit": true,
		"composite": false,
		"incremental": false,
		"declaration": false,
		"declarationMap": false
	},
	"include": [
		"**/*.ts",
		"../../src/**/*.ts"
	],
	"exclude": [
		"../../src/**/__tests__/**",
		"../../src/**/*.test.ts"
	]
}
