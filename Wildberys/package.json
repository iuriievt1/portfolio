{
  "name": "bluberi",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api-client:generate": "pnpm --filter @bluberi/api openapi && pnpm --filter @bluberi/api-client generate",
    "services:up": "docker compose up --detach --wait",
    "services:down": "docker compose down"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
