# Local services started by Docker Compose (compose.yaml).
# Copy this file to .env. Development values only, never use them anywhere else.

POSTGRES_PORT=5433
POSTGRES_USER=bluberi
POSTGRES_PASSWORD=bluberi-local-password
POSTGRES_DB=bluberi

REDIS_PORT=6379

MEILI_PORT=7700
MEILI_MASTER_KEY=bluberi-local-master-key

STORAGE_PORT=9100
STORAGE_CONSOLE_PORT=9101
STORAGE_ACCESS_KEY=bluberi-local
STORAGE_SECRET_KEY=bluberi-local-secret-key

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
