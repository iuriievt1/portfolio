# Settings of the store. Copy this file to .env. Development values only.

# Public address of the store, without a slash at the end. It goes into the addresses search
# engines and social networks read. The build needs it as well.
SITE_URL=http://localhost:3000

# The id of the Google Analytics property, like G-XXXXXXXXXX. Leave it empty to measure nothing:
# the store then loads no analytics and shows no cookie banner. The build reads it as well.
GOOGLE_ANALYTICS_ID=

# Address of the API. The store calls it from its server side.
API_URL=http://localhost:4000

# Address of the seller portal. The links for sellers lead there.
SELLER_URL=http://localhost:3001
