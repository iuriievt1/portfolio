enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT

  @@map("attribute_type")
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED

  @@map("product_status")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null for top-level categories.
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String   @unique
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  attributes   CategoryAttribute[]
  products     Product[]
  stores       StoreCategory[]

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  categoryId String @map("category_id") @db.Uuid
  locale     Locale
  name       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

/// A characteristic of a product, for example size, color, material or CE marking.
model Attribute {
  id        String        @id @default(uuid(7)) @db.Uuid
  /// Stable name used in code and imports, for example "size".
  code      String        @unique
  type      AttributeType
  /// Unit of a number, for example "ml" or "cm".
  unit      String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations   AttributeTranslation[]
  options        AttributeOption[]
  categories     CategoryAttribute[]
  productValues  ProductAttributeValue[]
  variantOptions VariantOption[]

  @@map("attributes")
}

model AttributeTranslation {
  attributeId String @map("attribute_id") @db.Uuid
  locale      Locale
  name        String

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([attributeId, locale])
  @@map("attribute_translations")
}

/// One allowed value of a SELECT or MULTI_SELECT attribute, for example size "M".
model AttributeOption {
  id          String   @id @default(uuid(7)) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  code        String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attribute      Attribute                    @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations   AttributeOptionTranslation[]
  productValues  ProductAttributeValue[]
  variantOptions VariantOption[]

  @@unique([attributeId, code])
  @@map("attribute_options")
}

model AttributeOptionTranslation {
  optionId String @map("option_id") @db.Uuid
  locale   Locale
  name     String

  option AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
  @@map("attribute_option_translations")
}

/// Which attributes a category uses and which of them a product must fill in.
model CategoryAttribute {
  categoryId    String  @map("category_id") @db.Uuid
  attributeId   String  @map("attribute_id") @db.Uuid
  /// A product in this category cannot be published without this attribute.
  isRequired    Boolean @default(false) @map("is_required")
  /// Variants of a product differ by this attribute, for example size or color.
  isVariantAxis Boolean @default(false) @map("is_variant_axis")
  position      Int     @default(0)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

/// A product exists once. Sellers attach offers to its variants.
model Product {
  id                       String        @id @default(uuid(7)) @db.Uuid
  categoryId               String        @map("category_id") @db.Uuid
  brandId                  String?       @map("brand_id") @db.Uuid
  slug                     String        @unique
  status                   ProductStatus @default(DRAFT)
  /// Store that first added the product. Null when the Bluberi team added it.
  createdByStoreId         String?       @map("created_by_store_id") @db.Uuid
  /// GPSR: who made the product and how to reach them.
  manufacturerName         String?       @map("manufacturer_name")
  manufacturerAddress      String?       @map("manufacturer_address")
  manufacturerContact      String?       @map("manufacturer_contact")
  /// GPSR: the responsible person in the EU, needed when the manufacturer is outside the EU.
  responsiblePersonName    String?       @map("responsible_person_name")
  responsiblePersonAddress String?       @map("responsible_person_address")
  responsiblePersonContact String?       @map("responsible_person_contact")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand           Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdByStore  Store?                  @relation(fields: [createdByStoreId], references: [id], onDelete: SetNull)
  translations    ProductTranslation[]
  attributeValues ProductAttributeValue[]
  images          ProductImage[]
  variants        ProductVariant[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([createdByStoreId])
  @@map("products")
}

model ProductTranslation {
  productId   String @map("product_id") @db.Uuid
  locale      Locale
  name        String
  description String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@map("product_translations")
}

/// The value of one attribute for a product. A MULTI_SELECT attribute has one row per chosen option.
model ProductAttributeValue {
  id           String   @id @default(uuid(7)) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  attributeId  String   @map("attribute_id") @db.Uuid
  /// Set for SELECT and MULTI_SELECT attributes.
  optionId     String?  @map("option_id") @db.Uuid
  textValue    String?  @map("text_value")
  numberValue  Decimal? @map("number_value") @db.Decimal(18, 4)
  booleanValue Boolean? @map("boolean_value")

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute        @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  option    AttributeOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId, optionId])
  @@index([attributeId])
  @@index([optionId])
  @@map("product_attribute_values")
}

/// One sellable version of a product, for example the pink hoodie in size M.
model ProductVariant {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Global Trade Item Number (EAN barcode), when the item has one.
  gtin      String?  @unique
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    VariantOption[]
  images     ProductImage[]
  offers     Offer[]
  stockItems StockItem[]

  @@index([productId])
  @@map("product_variants")
}

/// The option a variant has on one variant axis, for example size = M.
model VariantOption {
  variantId   String @map("variant_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  optionId    String @map("option_id") @db.Uuid

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  option    AttributeOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@index([attributeId])
  @@index([optionId])
  @@map("variant_options")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Set when the photo shows one variant, for example one color.
  variantId String?  @map("variant_id") @db.Uuid
  /// Key of the file in S3 storage.
  fileKey   String   @map("file_key")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}
