# Settings of the API. Copy this file to .env. Development values only.
# Every setting is required: the API does not start when one is missing or wrong.

PORT=4000
DATABASE_URL=postgresql://bluberi:bluberi-local-password@localhost:5433/bluberi

# pretty for a terminal, json for servers.
LOG_FORMAT=pretty

# The web apps that may call the API, separated by commas.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Serve the API documentation under /docs.
API_DOCS_ENABLED=true

# Signs access tokens. At least 32 characters, random and different on every server.
ACCESS_TOKEN_SECRET=bluberi-local-access-token-secret-0000
# Hashes one-time codes. At least 32 characters, random and different on every server.
ONE_TIME_CODE_SECRET=bluberi-local-one-time-code-secret-000

# The mail server and the sender of outgoing emails. Locally the server is Mailpit.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Bluberi <no-reply@bluberi.cz>"

# S3 storage for photos. Locally it is the storage service from compose.yaml,
# the keys are the same as in the .env file in the repository root.
STORAGE_ENDPOINT=http://localhost:9100
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=bluberi-local
STORAGE_SECRET_KEY=bluberi-local-secret-key
STORAGE_BUCKET=bluberi
# The bucket for files only the API reads, like the documents of sellers. Nobody reads it by address.
STORAGE_PRIVATE_BUCKET=bluberi-private
# The address files are read from, without a slash at the end.
STORAGE_PUBLIC_URL=http://localhost:9100/bluberi

# The Czech register of companies (ARES). The API reads the name, the address and the tax number
# of a company from it by the company number (IČO). It is public and needs no key.
ARES_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest

# The register of VAT numbers of the EU (VIES). The API checks the VAT number of a company
# from another EU country in it. It is public and needs no key.
VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# Redis. Locally it is the redis service from compose.yaml. The copies of the API tell each other
# through it what changed, so that open pages show it at once.
REDIS_URL=redis://localhost:6379
# The word in front of everything the API names in Redis. Two environments on one server need two words.
REDIS_NAMESPACE=bluberi
