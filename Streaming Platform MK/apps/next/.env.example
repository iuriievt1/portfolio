# ============================================================================
# Next.js App — Environment Variables
# ============================================================================
# Copy this file to .env.local (Next.js convention for local env files).
#
# NEXT_PUBLIC_ prefix = inlined into JS bundle, visible in browser.
# No prefix = server-only, available at build time only.
# ============================================================================

# --- Data Source ---
# "mock" = TMDB demo data, "api" = live MK API
NEXT_PUBLIC_DATA_SOURCE=api

# --- TMDB (for mock data) ---
# Free read token from https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_READ_TOKEN=

# --- MK API (client-safe, visible in browser bundle) ---
NEXT_PUBLIC_MK_API_HOST=
NEXT_PUBLIC_MK_TENANT_ID=tenant_token
NEXT_PUBLIC_MK_STORE_ID=

# --- Hub ID overrides (optional, auto-discovered if not set) ---
NEXT_PUBLIC_MK_HOME_HUB_ID=
NEXT_PUBLIC_MK_USER_ACCESS_TOKEN=

# NEXT_PUBLIC_MK_SPORTS_HUB_ID=
# NEXT_PUBLIC_MK_KIDS_HUB_ID=

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---
# MK_USER_ACCESS_TOKEN=

# --- Next.js Public ---
# NEXT_PUBLIC_DEMO_PASSWORD=
# NEXT_PUBLIC_MKPLAYER_KEY=
# NEXT_PUBLIC_MKPLAYER_ANALYTICS_KEY=
