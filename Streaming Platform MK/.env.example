# ============================================================================
# MediaKind Cross-Platform App — Environment Variables
# ============================================================================
# Copy this file to .env and set DATA_SOURCE to "mock" or "api".
# ============================================================================

# --- Mode ---
# "mock" → TMDB movies + hardcoded sports/kids (needs NEXT_PUBLIC_TMDB_READ_TOKEN)
# "api"  → Real MK backend (needs Firebase OR Direct Host vars below)
DATA_SOURCE=mock

# --- TMDB (mock mode) ---
# Free read token: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_READ_TOKEN=

# --- MK API: Firebase Discovery (api mode, recommended) ---
# Auto-discovers host, tenant, and hub IDs from Firebase Remote Config.
# Values are in the Bruno collection: 0 Config / Firebase Remote Config.
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=

# --- MK API: Direct Host (api mode, alternative to Firebase) ---
# Skips Firebase — you must also set hub IDs manually (see below).
# MK_API_HOST=
# MK_TENANT_ID=

# --- MK API: Dual Tenant (optional) ---
# Browse content from a different tenant than video playback.
# Tenant1 handles auth + VOD, content tenant provides the catalog UI.
# MK_CONTENT_TENANT_ID=tenant2
# MK_CONTENT_HOME_HUB_ID=706935ec-755a-4ceb-b80d-47c130d72e0e

# --- Store switcher (optional) ---
# Comma-separated allowlist of stores the switcher may offer. Each entry matches
# either the store label (`IBC Sports`) or the full id (`HubsAndFeeds-!tenant1!IBC Sports`).
# Omit or leave empty to offer every store the tenant returns. An allowlist that
# matches nothing falls back to the full list rather than blanking the switcher.
# NEXT_PUBLIC_MK_VISIBLE_STORES=IBC Sports

# --- Hub ID overrides (optional) ---
# Force specific hub IDs instead of auto-discovery by name.
# Firebase discovers these automatically. Direct Host requires at least MK_HOME_HUB_ID.
# MK_HOME_HUB_ID=
# MK_SPORTS_HUB_ID=
# MK_KIDS_HUB_ID=

# --- Feed display overrides (optional) ---
# CSV of feed IDs to render as hero carousels instead of rails.
# MK_JUMBO_FEED_IDS=

# --- User Access Token (optional, enables Continue Watching) ---
# MK_USER_ACCESS_TOKEN=

# --- Account switcher (optional) ---
# Switchable demo accounts. Names/e-mails are NOT configured here — they are read
# from the MK API per token (/sts/bootstrap AccountId, /subscriber/v1/profiles Name).
# `name` is only an optional presentation override.
# `avatarUrl` is the account's picture — MK returns none, so it is configured here.
# App-relative paths (`/logos/…`) get the deploy's base path applied automatically.
# Accounts without one render their initials.
# JSON form:
# NEXT_PUBLIC_MK_ACCOUNTS=[{"token":"<token-1>","avatarUrl":"/logos/avatar-jake.png"},{"token":"<token-2>","name":"Ryan Andrew"}]
# Or just a comma-separated list of tokens:
# NEXT_PUBLIC_MK_ACCOUNTS=<token-1>,<token-2>,<token-3>

# --- Demo login wall (optional) ---
# Set a password to gate the app behind a simple login form.
# Omit or leave empty to disable the gate.
# NEXT_PUBLIC_DEMO_PASSWORD=

# --- Client-side ---
# MKPlayer SDK license key
# NEXT_PUBLIC_MKPLAYER_KEY=91c1e62d-1547-464b-a73c-4701fc5dea24
# NEXT_PUBLIC_MKPLAYER_ANALYTICS_KEY=
